# Exemplo de configuração da instalação. Copie para .docker/stack.env
# (gerado pelo install/up). NÃO versione o arquivo real — contém segredos.
#
# GETFY_DB_PASSWORD e tokens podem ter cifrões; o compose usa stack.compose.env
# ($$) gerado por docker/write-compose-env.sh.

GETFY_COMPOSE_PROJECT_NAME=getfy
GETFY_COMPOSE_FILES=docker-compose.yml
GETFY_APP_URL=https://exemplo.example
GETFY_WEBHOOK_PUBLIC_URL=https://exemplo.example
GETFY_HTTP_PORT=80
GETFY_HTTPS_PORT=443
GETFY_CADDY_HOST=:80

GETFY_DB_CONNECTION=pgsql
GETFY_DB_HOST=postgres
GETFY_DB_PORT=5432
GETFY_DB_DATABASE=getfy
GETFY_DB_USERNAME=change-me
GETFY_DB_PASSWORD=change-me

GETFY_APP_ENV=production
GETFY_APP_DEBUG=false
GETFY_QUEUE_CONNECTION=redis
GETFY_CACHE_STORE=redis
GETFY_SESSION_DRIVER=file

STACKER_AGENT_TOKEN=
